<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/primary" android:elevation="4dp" app:navigationIcon="@drawable/ic_arrow_back" app:title="收获排行榜" app:titleTextColor="@android:color/white" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" android:orientation="horizontal">
            <Button android:id="@+id/btn_daily" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:minWidth="0dp" android:backgroundTint="@color/primary" android:text="本日" android:textColor="@color/background" android:textSize="14sp" />
            <Button android:id="@+id/btn_weekly" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="8dp" android:minWidth="0dp" android:backgroundTint="@color/on_surface_variant" android:text="本周" android:textColor="@color/background" android:textSize="14sp" />
            <Button android:id="@+id/btn_monthly" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="8dp" android:minWidth="0dp" android:backgroundTint="@color/on_surface_variant" android:text="本月" android:textColor="@color/background" android:textSize="14sp" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_rank" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="12dp" android:paddingEnd="12dp" />
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>