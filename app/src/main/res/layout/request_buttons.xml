<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
    <Button android:id="@+id/btn_accept" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:backgroundTint="@color/primary" android:text="接受" android:textColor="@color/background" android:textSize="13sp" />
    <Button android:id="@+id/btn_reject" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginStart="8dp" android:backgroundTint="@color/on_surface_variant" android:text="拒绝" android:textColor="@color/background" android:textSize="13sp" />
</LinearLayout>