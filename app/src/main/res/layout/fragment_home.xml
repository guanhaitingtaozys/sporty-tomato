<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ========== 顶部数据卡片：步数 & 能量 ========== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/background"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_step_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="今日步数"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp" />

                <!-- 步数数值 — 40sp 粗体大号 -->
                <TextView
                    android:id="@+id/tv_today_steps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="@color/primary"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <!-- 能量进度条: 渐变 #FF9800 → #4CAF50 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ProgressBar
                        android:id="@+id/progress_energy"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="14dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_gradient" />

                    <TextView
                        android:id="@+id/tv_energy_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="0/1000"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========== 中心番茄形象区 ========== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_tomato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/background"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- 番茄形象（200dp，装饰光晕背景 + 浮动动画） -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <!-- 装饰性圆形光晕背景 -->
                    <ImageView
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="center"
                        android:src="@drawable/bg_tomato_decor"
                        android:contentDescription="装饰背景"
                        android:elevation="0dp" />

                    <ImageView
                        android:id="@+id/view_tomato_image"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center"
                        android:contentDescription="番茄形象"
                        android:src="@drawable/circle_tomato"
                        android:scaleType="fitCenter" />

                    <!-- 浇水动画叠加层（圆形毛玻璃背景 + 矢量水壶，elevation 确保在最上层） -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_watering_clip"
                        android:visibility="gone"
                        android:elevation="6dp"
                        android:id="@+id/view_watering_overlay">
                        <ImageView
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:layout_gravity="center"
                            android:contentDescription="浇水动画"
                            android:src="@drawable/ic_watering_can"
                            android:scaleType="fitCenter" />
                    </FrameLayout>
                </FrameLayout>

                <!-- 当前阶段名称 -->
                <TextView
                    android:id="@+id/tv_tomato_stage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="种子阶段"
                    android:textColor="@color/on_surface"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- 进度百分比 -->
                <TextView
                    android:id="@+id/tv_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0/5 (0%)"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="14sp" />

                <!-- 成长进度条 (渐变: 橙→绿) -->
                <ProgressBar
                    android:id="@+id/progress_tomato"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_gradient" />

                <!-- 成长提示文字 -->
                <TextView
                    android:id="@+id/tv_growth_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="坚持运动，让番茄茁壮成长！"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========== 底部操作区 ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- 浇水按钮：全宽圆角矩形，主色 -->
            <Button
                android:id="@+id/btn_water"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/button_primary"
                android:text="浇水 (消耗100能量)"
                android:textColor="@color/background"
                android:textSize="16sp"
                android:elevation="4dp" />

            <!-- 刷新步数按钮（较小） -->
            <Button
                android:id="@+id/btn_refresh_steps"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#607D8B"
                android:text="刷新步数"
                android:textColor="@color/background"
                android:textSize="13sp" />

            <!-- 收获按钮（初始隐藏，进度≥100时显示） -->
            <Button
                android:id="@+id/btn_harvest"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/secondary"
                android:text="收获"
                android:textColor="@color/background"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- 能量提示信息 -->
            <TextView
                android:id="@+id/tv_energy_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="当前能量: 0"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
