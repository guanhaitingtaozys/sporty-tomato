<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/primary" android:elevation="4dp" app:navigationIcon="@drawable/ic_arrow_back" app:title="勋章墙" app:titleTextColor="@android:color/white" />
    <TextView android:id="@+id/tv_badge_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/surface_container_low" android:elevation="1dp" android:gravity="center" android:padding="14dp" android:text="已解锁 0/7 枚勋章" android:textColor="@color/primary" android:textSize="15sp" android:textStyle="bold" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_view_badges" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:padding="8dp" />
</LinearLayout>