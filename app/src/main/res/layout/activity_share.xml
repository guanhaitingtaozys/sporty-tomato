<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/primary" android:elevation="4dp" app:navigationIcon="@android:drawable/ic_menu_revert" app:title="分享收获" app:titleTextColor="@android:color/white" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:padding="16dp">
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="12dp" app:cardElevation="4dp">
                <ImageView android:id="@+id/iv_poster" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:contentDescription="分享海报" android:scaleType="fitCenter" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:padding="12dp">
        <Button android:id="@+id/btn_save_to_gallery" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:backgroundTint="@color/secondary" android:text="保存到相册" android:textColor="@android:color/white" android:textSize="14sp" />
        <Button android:id="@+id/btn_share_to_wechat" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:backgroundTint="@color/primary" android:text="分享到微信" android:textColor="@android:color/white" android:textSize="14sp" />
        <Button android:id="@+id/btn_copy_text" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:backgroundTint="@color/on_surface_variant" android:text="复制文案" android:textColor="@android:color/white" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>