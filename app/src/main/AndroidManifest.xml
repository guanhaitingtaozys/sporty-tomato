<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".view.SportyTomatoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SportyTomato">

        <activity android:name=".view.LoginActivity" android:exported="true" android:theme="@style/Theme.SportyTomato">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".view.MainActivity" android:exported="false" android:theme="@style/Theme.SportyTomato" />
        <activity android:name=".view.FriendListActivity" android:exported="false" />
        <activity android:name=".view.AddFriendActivity" android:exported="false" />
        <activity android:name=".view.RankActivity" android:exported="false" />
        <activity android:name=".view.BadgeWallActivity" android:exported="false" />
        <activity android:name=".view.ShareActivity" android:exported="false" />
        <activity android:name=".view.ChatActivity" android:exported="false" />

        <receiver android:name=".util.NotificationHelper$EnergyReminderReceiver" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <activity-alias
            android:name=".view.health.HealthConnectPermissionActivity"
            android:exported="true"
            android:targetActivity=".view.MainActivity"
            android:permission="android.permission.health.READ_STEPS">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.health.category.READ_STEPS" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>